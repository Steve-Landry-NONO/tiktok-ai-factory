OPENAI_API_KEY=
GROQ_API_KEY=
RUNWAY_API_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
LLM_PROVIDER=groq
VIDEO_PROVIDER=synthetic
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_JUDGE_MODEL=openai/gpt-oss-20b
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
RUNWAY_MODEL=gen4.5
RUNWAY_RATIO=720:1280
RUNWAY_CREDITS_PER_SECOND=12
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
MAX_COST_PER_VIDEO=10.0
MAX_DAILY_GENERATION_COST=100.0
MAX_RETRIES=3

POSTGRES_PASSWORD=local-development-only

# V4 control-plane API. Generate a long random token; never commit the real value.
FACTORY_API_TOKEN=
FACTORY_API_HOST=0.0.0.0
FACTORY_API_LOG_LEVEL=info
FACTORY_OUTPUT_ROOT=output/api
PORT=8000

# From the host or n8n Cloud use the public HTTPS API URL.
# If n8n shares the Docker Compose network, use http://factory-api:8000.
FACTORY_API_URL=http://localhost:8000
